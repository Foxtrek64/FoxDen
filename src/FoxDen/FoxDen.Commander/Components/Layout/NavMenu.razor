@rendermode InteractiveServer

<div class="navmenu">
    <nav class="sitenav" aria-labelledby="main-menu" />
    <FluentAppBar Id="main-menu">
        <FluentAppBarItem Href="/" Match="NavLinkMatch.All" IconActive="@(new Icons.Filled.Size24.Home())" IconRest="@(new Icons.Regular.Size24.Home())" Text="Home" />
        <FluentAppBarItem Href="counter" IconActive="@(new Icons.Filled.Size24.NumberSymbolSquare())" IconRest="@(new Icons.Regular.Size24.NumberSymbolSquare())" />
        <FluentAppBarItem Href="weather" IconActive="@(new Icons.Filled.Size24.WeatherPartlyCloudyDay())" IconRest="@(new Icons.Regular.Size24.WeatherPartlyCloudyDay())"  />
    </FluentAppBar>
</div>

